# Copie para .env e preencha. O .env NUNCA vai para o git.

# Token dado pelo @BotFather no Telegram (formato: 8123456789:AAF...)
TELEGRAM_BOT_TOKEN=

# Endereço do servidor de inferência local (llama-server).
# Bind local de propósito: o roteador roda no mesmo aparelho.
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Preenchido depois que você mandar a primeira mensagem ao bot — é para onde
# o Caipora envia lembretes proativos.
TELEGRAM_CHAT_ID=
